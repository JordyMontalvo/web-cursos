{
  "version": 2,
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    { "source": "/login",             "destination": "/login.html" },
    { "source": "/register",          "destination": "/register.html" },
    { "source": "/membresia",         "destination": "/membresia.html" },
    { "source": "/perfil",            "destination": "/perfil.html" },
    { "source": "/admin-login",       "destination": "/admin-login.html" },
    { "source": "/admin/content/:id", "destination": "/content-manager.html" },
    { "source": "/admin",             "destination": "/admin.html" },
    { "source": "/curso/:id",         "destination": "/curso.html" },

    { "source": "/api/admin/settings",        "destination": "/api/admin-settings.js" },
    { "source": "/api/settings",              "destination": "/api/settings.js" },
    { "source": "/api/config",              "destination": "/api/config.js" },
    { "source": "/api/auth/check-access",   "destination": "/api/auth.js" },
    { "source": "/api/auth/register",       "destination": "/api/auth.js" },
    { "source": "/api/auth/login",          "destination": "/api/auth.js" },
    { "source": "/api/auth/me",             "destination": "/api/auth.js" },

    { "source": "/api/memberships/subscribe", "destination": "/api/memberships.js" },
    { "source": "/api/memberships/:id",       "destination": "/api/memberships.js?id=:id" },
    { "source": "/api/memberships",           "destination": "/api/memberships.js" },

    { "source": "/api/admin/memberships/:id", "destination": "/api/admin-memberships.js?id=:id" },
    { "source": "/api/admin/memberships",     "destination": "/api/admin-memberships.js" },
    { "source": "/api/admin/users/:id/membership", "destination": "/api/admin-users.js?id=:id&membership=true" },
    { "source": "/api/admin/users",           "destination": "/api/admin-users.js" },

    { "source": "/api/courses/:id/chapters/:chapterId/episodes/:episodeId", "destination": "/api/courses.js?id=:id&chapterId=:chapterId&episodeId=:episodeId" },
    { "source": "/api/courses/:id/chapters/:chapterId/episodes",            "destination": "/api/courses.js?id=:id&chapterId=:chapterId" },
    { "source": "/api/courses/:id/chapters/:chapterId",                     "destination": "/api/courses.js?id=:id&chapterId=:chapterId" },
    { "source": "/api/courses/:id/chapters",                                "destination": "/api/courses.js?id=:id" },
    { "source": "/api/courses/:id",                                         "destination": "/api/courses.js?id=:id" },
    { "source": "/api/courses",                                             "destination": "/api/courses.js" },
    { "source": "/api/upload",                                              "destination": "/api/upload.js" }
  ]
}
