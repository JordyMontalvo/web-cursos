{
  "version": 2,
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    { "source": "/login",             "destination": "/login.html" },
    { "source": "/register",          "destination": "/register.html" },
    { "source": "/membresia",         "destination": "/membresia.html" },
    { "source": "/perfil",            "destination": "/perfil.html" },
    { "source": "/admin-login",       "destination": "/admin-login.html" },
    { "source": "/admin/content/:id", "destination": "/content-manager.html" },
    { "source": "/admin",             "destination": "/admin.html" },
    { "source": "/vendedor",          "destination": "/vendedor.html" },
    { "source": "/curso/:id",         "destination": "/curso.html" },

    { "source": "/api/config",              "destination": "/api/general?route=config" },
    { "source": "/api/settings",            "destination": "/api/general?route=public-settings" },
    { "source": "/api/landing-config",      "destination": "/api/general?route=public-landing-config" },
    { "source": "/api/banners",             "destination": "/api/general?route=public-banners" },
    { "source": "/api/admin/landing-config","destination": "/api/general?route=admin-landing-config" },
    { "source": "/api/jobs-renew-memberships", "destination": "/api/general?route=jobs-renew-memberships" },

    { "source": "/api/seller/stats",        "destination": "/api/seller" },
    { "source": "/api/seller/referrals",    "destination": "/api/seller" },
    { "source": "/api/seller/transactions",  "destination": "/api/seller" },
    { "source": "/api/seller/withdraw",      "destination": "/api/seller" },

    { "source": "/api/auth/check-access",   "destination": "/api/auth" },
    { "source": "/api/auth/register",       "destination": "/api/auth" },
    { "source": "/api/auth/login",          "destination": "/api/auth" },
    { "source": "/api/auth/forgot-password","destination": "/api/auth" },
    { "source": "/api/auth/reset-password", "destination": "/api/auth" },
    { "source": "/api/auth/me",             "destination": "/api/auth" },
    { "source": "/api/auth/google",         "destination": "/api/auth-oauth" },
    { "source": "/api/auth/github/callback","destination": "/api/auth-oauth" },
    { "source": "/api/auth/github",         "destination": "/api/auth-oauth" },

    { "source": "/api/memberships/subscribe", "destination": "/api/memberships" },
    { "source": "/api/payments/izipay-checkout", "destination": "/api/izipay" },
    { "source": "/api/payments/izipay-webhook",  "destination": "/api/izipay" },
    { "source": "/api/payments/izipay-return",   "destination": "/api/izipay" },
    { "source": "/api/memberships/:id",       "destination": "/api/memberships?id=:id" },
    { "source": "/api/memberships",           "destination": "/api/memberships" },

    { "source": "/api/admin/memberships/:id", "destination": "/api/admin-memberships?id=:id" },
    { "source": "/api/admin/memberships",     "destination": "/api/admin-memberships" },
    { "source": "/api/admin/users/:id/membership", "destination": "/api/admin-users?id=:id&membership=true" },
    { "source": "/api/admin/users",           "destination": "/api/admin-users" },
    { "source": "/api/admin-users/transactions", "destination": "/api/admin-users" },
    { "source": "/api/admin-users/withdrawals", "destination": "/api/admin-users" },
    { "source": "/api/admin/settings",        "destination": "/api/general?route=admin-settings" },
    { "source": "/api/admin/banners/:id",     "destination": "/api/admin-banners?id=:id" },
    { "source": "/api/admin/banners",         "destination": "/api/admin-banners" },
    { "source": "/api/admin/categories/:id",  "destination": "/api/categories?id=:id" },
    { "source": "/api/admin/categories",      "destination": "/api/categories" },

    { "source": "/api/coupons/validate",      "destination": "/api/general?route=coupons-validate" },
    { "source": "/api/admin/coupons/:id",     "destination": "/api/general?route=admin-coupons&id=:id" },
    { "source": "/api/admin/coupons",         "destination": "/api/general?route=admin-coupons" },

    { "source": "/api/courses/:id/chapters/:chapterId/episodes/:episodeId", "destination": "/api/courses?id=:id&chapterId=:chapterId&episodeId=:episodeId" },
    { "source": "/api/courses/:id/chapters/:chapterId/episodes",            "destination": "/api/courses?id=:id&chapterId=:chapterId&episodeId=new" },
    { "source": "/api/courses/:id/chapters/:chapterId",                     "destination": "/api/courses?id=:id&chapterId=:chapterId" },
    { "source": "/api/courses/:id/chapters",                                "destination": "/api/courses?id=:id&chapterId=new" },
    { "source": "/api/courses/:id",                                         "destination": "/api/courses?id=:id" },
    { "source": "/api/courses",                                             "destination": "/api/courses" },
    { "source": "/api/categories",                                          "destination": "/api/categories" },
    { "source": "/api/upload",                                              "destination": "/api/upload" }
  ]
}
